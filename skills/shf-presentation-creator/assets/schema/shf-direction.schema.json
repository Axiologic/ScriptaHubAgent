        },
        "text": {
          "type": "string",
          "maxLength": 600
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "origin": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        },
