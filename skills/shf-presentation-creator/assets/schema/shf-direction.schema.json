    "asset": {
      "type": "object",
      "required": [
        "mime"
      ],
      "properties": {
        "mime": {
          "enum": [
            "audio/mpeg",
            "audio/wav",
            "audio/ogg"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 239
        },
        "data": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/=\\s]*$"
        }
      },
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "data"
          ]
        }
      ]
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
