# Copy to .env, then fill ONLY the chosen provider. No real keys are bundled.
# Shell variables override .env. This file is read from the skill directory.
# Do not paste keys into agent messages, scores, generated HTML or version control.
# Optional default engine; `node bin/audio.mjs setup gemini` also records a default.
# AUDIO_ENGINE=gemini

# Recurring free/demo profiles (account eligibility and quotas still apply).
GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
GROQ_API_KEY=
# GROQ_TTS_VOICE=troy
HUME_API_KEY=
# HUME_TTS_MODEL=1
# HUME_VOICE_ID=Ava Song
CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
GOOGLE_TTS_API_KEY=
# Alternative to the Google Cloud API key: an OAuth token with cloud-platform access.
# GOOGLE_ACCESS_TOKEN=
# GOOGLE_CLOUD_PROJECT=
VOICERSS_API_KEY=

# One-time trials / eligibility-dependent credits, not recurring free quotas.
DEEPGRAM_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=

# Mistral: TTS API is implemented, but free TTS entitlement is not established.
MISTRAL_API_KEY=
MISTRAL_VOICE_ID=

# Optional paid provider; no universal free TTS API quota is assumed.
OPENAI_API_KEY=
