    {
      "name": "scriptahub_task_claim",
      "title": "Claim one approved task by type",
      "description": "Claim one queued task of taskType. For a reserved batch, use the batchId, taskId and durable runId returned by the local scriptahub-tasks batch helper and ScriptaHub. The workflow select-task step advances its fixed batch; processing steps must not claim additional work. An edit task contains all approved requests snapshotted by Submit new edition.",
      "command": "node",
      "args": [
        "tools/task-tool.mjs"
      ],
      "cwd": "/code",
      "timeoutMs": 650000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "taskId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "taskType": {
            "type": "string",
            "enum": [
              "manuscript",
              "edit"
            ]
          },
          "batchId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "runId"
        ],
        "additionalProperties": false
      },
      "tags": [
        "internal"
      ],
      "env": {
        "TOOL_NAME": "scriptahub_task_claim"
      }
    },
