    {
      "name": "scriptahub_task_package_prepare",
      "title": "Register a validated manuscript package",
      "description": "Register a validated manuscript package. Restricted to configured executor service identities. No credentials or local server paths are returned.",
      "command": "node",
      "args": [
        "tools/task-tool.mjs"
      ],
      "cwd": "/code",
      "timeoutMs": 90000,
      "inputSchema": {
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "maxLength": 128
          },
          "catalogue": {
            "type": "string",
            "maxLength": 4096
          },
          "branch": {
            "type": "string",
            "maxLength": 200
          },
          "baseCommit": {
            "type": "string",
            "maxLength": 40,
            "description": "Verified base commit. Omit only for an independently verified empty repository."
          },
          "files": {
            "type": "array",
            "minItems": 2,
            "maxItems": 500,
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "maxLength": 1024
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 50000000
                }
              },
              "required": [
                "path",
                "sha256",
                "size"
              ],
              "additionalProperties": false
            }
          },
          "validation": {
            "type": "object"
          }
        },
        "required": [
          "executionId",
          "catalogue",
          "branch",
          "files",
          "validation"
        ],
        "additionalProperties": false
      },
      "env": {
        "TOOL_NAME": "scriptahub_task_package_prepare"
      },
      "tags": [
        "internal"
      ]
    },
